@page "/compras"
@attribute [Authorize]
@using TarjetasCredito.Client.Services
@using TarjetasCredito.Shared.Dtos
@inject CreditCardApiService CreditCardApi
@inject PurchaseApiService PurchaseApi
@inject DialogService Dialogs
@inject IJSRuntime JS

<PageTitle>Compras</PageTitle>

<div class="page-header">
    <span class="page-icon-chip">🧾</span>
    <h1>Compras</h1>
</div>

@if (cargandoTarjetas)
{
    <EstadoCarga Cantidad="1" />
}
else if (sinConexionTarjetas || errorServidorTarjetas)
{
    <EstadoSinConexion SinConexion="sinConexionTarjetas" OnReintentar="CargarTarjetasAsync" />
}
else if (tarjetas.Count == 0)
{
    <EstadoVacio Icono="💳" Titulo="Registra primero una tarjeta" Descripcion="Necesitas al menos una tarjeta activa para poder registrar compras.">
        <a class="btn" href="tarjetas">Ir a Tarjetas</a>
    </EstadoVacio>
}
else
{
    <div class="card entrada-suave" id="formulario-compra">
        <h3>@(editandoId is null ? "Registrar compra" : "Editar compra")</h3>

        <EditForm Model="modelo" OnValidSubmit="GuardarAsync">
            <DataAnnotationsValidator />

            <div class="field">
                <label>Tarjeta</label>
                <InputSelect @bind-Value="modelo.CreditCardId">
                    @foreach (var t in tarjetas)
                    {
                        <option value="@t.Id">@t.Nombre</option>
                    }
                </InputSelect>
            </div>
            <div class="field">
                <label>Monto</label>
                <InputMonto @bind-Value="modelo.Monto" />
            </div>
            <div class="field">
                <label>Descripción</label>
                <InputText @bind-Value="modelo.Descripcion" />
            </div>
            <div class="field">
                <label>Categoría</label>
                <InputCombo @bind-Value="modelo.Categoria" Sugerencias="categoriasSugeridas" Placeholder="Elige o escribe una nueva" />
            </div>
            <div class="field">
                <label>Fecha</label>
                <InputDate @bind-Value="modelo.Fecha" />
            </div>
            <div class="field">
                <label>Meses sin intereses (opcional)</label>
                <InputNumber @bind-Value="modelo.Msi" />
            </div>

            <div style="display:flex; gap:0.6rem;">
                <button class="btn" type="submit" disabled="@(guardando || modelo.Monto is null or <= 0)">
                    @(guardando ? "Guardando..." : (editandoId is null ? "Registrar compra" : "Guardar cambios"))
                </button>
                @if (editandoId is not null)
                {
                    <button class="btn btn-secondary" type="button" style="width:auto;" @onclick="CancelarEdicionAsync">Cancelar</button>
                }
            </div>
        </EditForm>
    </div>

    <h3>Historial</h3>
    @if (cargandoHistorial)
    {
        <EstadoCarga Cantidad="3" />
    }
    else if (sinConexionHistorial || errorServidorHistorial)
    {
        <EstadoSinConexion SinConexion="sinConexionHistorial" OnReintentar="CargarComprasAsync" />
    }
    else
    {
        <div style="display:flex; gap:1rem; flex-wrap:wrap;">
            <div class="field" style="max-width:22rem; flex:1; min-width:12rem;">
                <label>Tarjeta a consultar</label>
                <select @bind="tarjetaFiltroId" @bind:after="ResetearPagina">
                    <option value="todas">Ver todos</option>
                    @foreach (var t in tarjetas)
                    {
                        <option value="@t.Id">@t.Nombre</option>
                    }
                </select>
            </div>
            <div class="field" style="max-width:14rem; flex:1; min-width:10rem;">
                <label>Periodo</label>
                <select @bind="periodoFiltro" @bind:after="ResetearPagina">
                    <option value="mes">Mes actual</option>
                    <option value="ultimoCorte">Último corte</option>
                    <option value="especifico">Elegir mes</option>
                </select>
            </div>
            @if (periodoFiltro == "especifico")
            {
                <div class="field" style="max-width:10rem; flex:1; min-width:8rem;">
                    <label>Mes</label>
                    <select @bind="mesEspecifico" @bind:after="ResetearPagina">
                        @for (var m = 1; m <= 12; m++)
                        {
                            <option value="@m">@NombresMeses[m - 1]</option>
                        }
                    </select>
                </div>
                <div class="field" style="max-width:8rem; flex:1; min-width:6rem;">
                    <label>Año</label>
                    <select @bind="anioEspecifico" @bind:after="ResetearPagina">
                        @foreach (var a in AniosDisponibles)
                        {
                            <option value="@a">@a</option>
                        }
                    </select>
                </div>
            }
        </div>

        @if (ComprasFiltradas.Count == 0)
        {
            <EstadoVacio Icono="🧾" Titulo="Aún no hay compras"
                         Descripcion="@(compras.Count == 0 ? "Las compras que registres arriba van a aparecer aquí, ordenadas por fecha." : "No hay compras que coincidan con estos filtros. Prueba cambiar la tarjeta o el periodo.")" />
        }
        else
        {
            @foreach (var c in ComprasPaginadas)
            {
                <div class="card compra-item card-interactive entrada-suave @(editandoId == c.Id ? "item-en-edicion" : "")">
                    <div>
                        <strong>@c.Descripcion</strong>
                        <div class="text-muted">@c.NombreTarjeta · @c.Categoria · @FechaFormato.Corta(c.Fecha)</div>
                    </div>
                    <div style="display:flex; align-items:center; gap:0.5rem;">
                        <div class="compra-item-monto">$@c.Monto.ToString("N2", System.Globalization.CultureInfo.InvariantCulture)</div>
                        <button type="button" class="btn btn-secondary" style="width:auto; padding:0.35rem 0.55rem;" title="Editar" @onclick="() => EditarAsync(c)">✏️</button>
                        <button type="button" class="btn btn-danger" style="width:auto; padding:0.35rem 0.55rem;" title="Eliminar" @onclick="() => EliminarAsync(c)">🗑️</button>
                    </div>
                </div>
            }

            @if (TotalPaginas > 1)
            {
                <div style="display:flex; align-items:center; justify-content:center; gap:1rem; margin-top:1rem;">
                    <button class="btn btn-secondary" style="width:auto;" disabled="@(paginaActual <= 1)" @onclick="() => paginaActual--">← Anterior</button>
                    <span class="text-muted">Página @paginaActual de @TotalPaginas</span>
                    <button class="btn btn-secondary" style="width:auto;" disabled="@(paginaActual >= TotalPaginas)" @onclick="() => paginaActual++">Siguiente →</button>
                </div>
            }
        }
    }
}

@code {
    private List<CreditCardDto> tarjetas = [];
    private List<PurchaseDto> compras = [];
    private List<string> categoriasSugeridas = [];
    private bool cargandoTarjetas = true;
    private bool sinConexionTarjetas;
    private bool errorServidorTarjetas;
    private bool cargandoHistorial = true;
    private bool sinConexionHistorial;
    private bool errorServidorHistorial;
    private bool guardando;
    private Guid? editandoId;
    private NuevaCompraModelo modelo = new();
    private string tarjetaFiltroId = "todas";
    private string periodoFiltro = "mes";
    private int mesEspecifico = DateTime.Now.Month;
    private int anioEspecifico = DateTime.Now.Year;
    private int paginaActual = 1;
    private const int TamanoPagina = 10;

    private static readonly string[] NombresMeses =
    [
        "Enero", "Febrero", "Marzo", "Abril", "Mayo", "Junio",
        "Julio", "Agosto", "Septiembre", "Octubre", "Noviembre", "Diciembre"
    ];

    private List<int> AniosDisponibles => compras
        .Select(c => c.Fecha.Year)
        .Append(DateTime.Now.Year)
        .Distinct()
        .OrderByDescending(a => a)
        .ToList();

    /// <summary>Combina el filtro de tarjeta con el de periodo (ver SPEC-005 "Filtro de periodo y
    /// paginación"). "Último corte" mira el `DiaCorte` de la tarjeta de CADA compra — con "Ver todos"
    /// puede haber tarjetas con días de corte distintos, así que no hay un solo corte global.
    /// "Elegir mes" (Sprint 44) es la única forma de ver una compra de un ciclo ya cerrado — "Mes
    /// actual"/"Último corte" la excluyen por diseño, y eso se reportó como bug ("no se registró la
    /// compra") cuando en realidad sí estaba guardada, solo no había manera de verla.</summary>
    private List<PurchaseDto> ComprasFiltradas
    {
        get
        {
            var query = tarjetaFiltroId == "todas" ? compras : compras.Where(c => c.CreditCardId.ToString() == tarjetaFiltroId);
            var hoy = DateTime.Now;

            query = periodoFiltro switch
            {
                "ultimoCorte" => query.Where(c => c.Fecha >= UltimoCorteDeLaTarjeta(c.CreditCardId, hoy)),
                "especifico" => query.Where(c => c.Fecha.Month == mesEspecifico && c.Fecha.Year == anioEspecifico),
                _ => query.Where(c => c.Fecha.Month == hoy.Month && c.Fecha.Year == hoy.Year)
            };

            return query.OrderByDescending(c => c.Fecha).ToList();
        }
    }

    private int TotalPaginas => Math.Max(1, (int)Math.Ceiling(ComprasFiltradas.Count / (double)TamanoPagina));

    private List<PurchaseDto> ComprasPaginadas
    {
        get
        {
            var filtradas = ComprasFiltradas;
            var totalPaginas = Math.Max(1, (int)Math.Ceiling(filtradas.Count / (double)TamanoPagina));
            if (paginaActual > totalPaginas)
            {
                paginaActual = totalPaginas;
            }
            return filtradas.Skip((paginaActual - 1) * TamanoPagina).Take(TamanoPagina).ToList();
        }
    }

    private DateTime UltimoCorteDeLaTarjeta(Guid creditCardId, DateTime hoy)
    {
        var tarjeta = tarjetas.FirstOrDefault(t => t.Id == creditCardId);
        return tarjeta is null ? DateTime.MinValue : CicloFacturacionCliente.UltimoCorte(tarjeta.DiaCorte, hoy);
    }

    private void ResetearPagina() => paginaActual = 1;

    protected override async Task OnInitializedAsync()
    {
        await CargarTarjetasAsync();
        await CargarComprasAsync();
        await CargarCategoriasAsync();
    }

    private async Task CargarTarjetasAsync()
    {
        cargandoTarjetas = true;
        sinConexionTarjetas = false;
        errorServidorTarjetas = false;

        var resultado = await CreditCardApi.ObtenerTodasAsync();
        if (resultado.Exitoso)
        {
            tarjetas = resultado.Datos!;
            if (tarjetas.Count > 0 && modelo.CreditCardId == Guid.Empty)
            {
                modelo.CreditCardId = tarjetas[0].Id;
            }
        }
        else
        {
            sinConexionTarjetas = resultado.SinConexion;
            errorServidorTarjetas = resultado.ErrorServidor;
        }

        cargandoTarjetas = false;
    }

    private async Task CargarComprasAsync()
    {
        cargandoHistorial = true;
        sinConexionHistorial = false;
        errorServidorHistorial = false;

        var resultado = await PurchaseApi.ObtenerTodasAsync();
        if (resultado.Exitoso)
        {
            compras = resultado.Datos!;
        }
        else
        {
            sinConexionHistorial = resultado.SinConexion;
            errorServidorHistorial = resultado.ErrorServidor;
        }

        cargandoHistorial = false;
    }

    private async Task CargarCategoriasAsync()
    {
        // Secundario: si falla, el datalist simplemente queda vacío — no bloquea registrar la compra
        // (el usuario puede seguir escribiendo la categoría a mano).
        var resultado = await PurchaseApi.ObtenerCategoriasAsync();
        if (resultado.Exitoso)
        {
            categoriasSugeridas = resultado.Datos!;
        }
    }

    private async Task GuardarAsync()
    {
        guardando = true;

        try
        {
            var request = new CrearPurchaseRequest(
                modelo.CreditCardId, modelo.Monto ?? 0, modelo.Descripcion,
                string.IsNullOrWhiteSpace(modelo.Categoria) ? "Otro" : modelo.Categoria,
                modelo.Fecha.ToUniversalTime(), modelo.Msi);

            var response = editandoId is null
                ? await PurchaseApi.CrearAsync(request)
                : await PurchaseApi.ActualizarAsync(editandoId.Value, request);

            if (response.IsSuccessStatusCode)
            {
                var eraEdicion = editandoId is not null;
                modelo = new() { CreditCardId = tarjetas[0].Id };
                editandoId = null;
                await CargarComprasAsync();
                await CargarCategoriasAsync();
                // Registrar/editar/eliminar una compra cambia el saldo disponible de la tarjeta — hay
                // que refrescar `tarjetas` para que el resto de la página (y cualquier otra que dependa
                // de este mismo servicio) no se quede mostrando el Disponible/Utilización de antes.
                await CargarTarjetasAsync();
                await Dialogs.ToastExitoAsync(eraEdicion ? "Compra actualizada." : "Compra registrada.");
            }
            else
            {
                var mensaje = await ErrorMessageHelper.ExtraerMensajeAsync(response, "No se pudo guardar la compra. Intenta de nuevo.");
                await Dialogs.ToastErrorAsync(mensaje);
            }
        }
        catch (Exception ex) when (ex is HttpRequestException or TaskCanceledException)
        {
            await Dialogs.ToastErrorAsync("No se pudo conectar. Revisa tu conexión a internet.");
        }
        finally
        {
            guardando = false;
        }
    }

    private async Task EditarAsync(PurchaseDto c)
    {
        editandoId = c.Id;
        modelo = new NuevaCompraModelo
        {
            CreditCardId = c.CreditCardId,
            Monto = c.Monto,
            Descripcion = c.Descripcion,
            Categoria = c.Categoria,
            Fecha = c.Fecha.ToLocalTime(),
            Msi = c.Msi
        };

        await JS.InvokeVoidAsync("domUtils.scrollIntoView", "formulario-compra");
    }

    private Task CancelarEdicionAsync()
    {
        editandoId = null;
        modelo = new() { CreditCardId = tarjetas[0].Id };
        return Task.CompletedTask;
    }

    private async Task EliminarAsync(PurchaseDto c)
    {
        var confirmado = await Dialogs.ConfirmarEliminarAsync(
            $"¿Eliminar \"{c.Descripcion}\"?",
            "Esta acción no se puede deshacer.",
            "Eliminar");

        if (!confirmado)
        {
            return;
        }

        try
        {
            var response = await PurchaseApi.EliminarAsync(c.Id);
            if (response.IsSuccessStatusCode)
            {
                if (editandoId == c.Id)
                {
                    await CancelarEdicionAsync();
                }
                await CargarComprasAsync();
                await CargarTarjetasAsync();
                await Dialogs.ToastExitoAsync("Compra eliminada.");
            }
            else
            {
                await Dialogs.ToastErrorAsync("No se pudo eliminar. Intenta de nuevo.");
            }
        }
        catch (Exception ex) when (ex is HttpRequestException or TaskCanceledException)
        {
            await Dialogs.ToastErrorAsync("No se pudo conectar. Revisa tu conexión a internet.");
        }
    }

    private class NuevaCompraModelo
    {
        public Guid CreditCardId { get; set; }
        public decimal? Monto { get; set; }
        public string Descripcion { get; set; } = "";
        public string Categoria { get; set; } = "Otro";
        public DateTime Fecha { get; set; } = DateTime.Now;
        public int? Msi { get; set; }
    }
}
