@page "/"
@attribute [Authorize]
@using TarjetasCredito.Client.Services
@using TarjetasCredito.Shared.Dtos
@inject CreditCardApiService CreditCardApi
@inject RecommendationApiService RecommendationApi
@inject PaymentReminderApiService RemindersApi
@inject UserProfileService UserProfile
@inject DialogService Dialogs
@implements IDisposable

<PageTitle>Dashboard</PageTitle>

<div class="page-header">
    <span class="page-icon-chip">🏠</span>
    <h1>Hola@(string.IsNullOrWhiteSpace(UserProfile.Perfil?.Nombres) ? "" : $", {UserProfile.Perfil.Nombres}") 👋</h1>
</div>
<p>¿Con qué tarjeta conviene pagar hoy?</p>

@if (cargando)
{
    <EstadoCarga Cantidad="2" />
}
else if (sinConexion || errorServidor)
{
    <EstadoSinConexion SinConexion="sinConexion" OnReintentar="CargarAsync" />
}
else if (tarjetas.Count == 0)
{
    <EstadoVacio Icono="💳" Titulo="Registra tu primera tarjeta" Descripcion="Agrega una tarjeta de crédito para empezar a recibir recomendaciones de pago y recordatorios automáticos.">
        <a class="btn" href="tarjetas">Registrar mi primera tarjeta</a>
    </EstadoVacio>
}
else
{
    <div class="card entrada-suave">
        <h3>¿Qué tarjeta uso hoy?</h3>
        <div class="field">
            <label>Monto de la compra</label>
            <div class="input-currency">
                <span class="input-currency-prefix">$</span>
                <input type="number" min="0" step="0.01" @bind="monto" @bind:event="oninput" placeholder="0.00" />
            </div>
        </div>
        <button class="btn" @onclick="RecomendarAsync" disabled="@(monto <= 0 || recomendando)">
            @(recomendando ? "Calculando..." : "Recomendar tarjeta")
        </button>

        @if (recomendacion is not null)
        {
            @if (recomendacion.CreditCardIdRecomendada is not null)
            {
                <div class="alert @(recomendacion.Advertencia ? "alert-danger" : "alert-info")" style="margin-top:1rem;">
                    <strong>@recomendacion.NombreTarjetaRecomendada</strong>
                    <p style="margin:0.35rem 0 0;">@recomendacion.Explicacion</p>
                </div>
            }
            else
            {
                <div class="alert alert-danger" style="margin-top:1rem;">@recomendacion.Explicacion</div>
            }
        }
    </div>

    @if (proximosVencimientos.Count > 0)
    {
        <div class="card entrada-suave">
            <h3>Próximos vencimientos</h3>
            @foreach (var r in proximosVencimientos)
            {
                <div class="recordatorio-header card-interactive" style="margin-bottom:0.6rem; padding:0.4rem; border-radius:var(--radius-sm);">
                    <span class="recordatorio-color" style="background:@r.ColorHex;"></span>
                    <strong style="flex:1;">@r.NombreTarjeta</strong>
                    <span class="badge @UrgenciaClase(r.Urgencia)">@FechaFormato.Corta(r.FechaLimitePago)</span>
                </div>
            }
            <a class="btn btn-secondary" style="width:auto;" href="pagos">Ver todos</a>
        </div>
    }

    <div class="card entrada-suave">
        <h3>📈 Mejora tu score</h3>
        <p>Qué hacer con cada tarjeta hoy para cuidar tu historial crediticio.</p>
        @foreach (var t in tarjetas)
        {
            var recordatorio = RecordatorioRelevante(t.Id);

            if (recordatorio is not null)
            {
                var fase = FaseDeCiclo(recordatorio, DateTime.Now.Date);
                <div class="recordatorio-header card-interactive" style="margin-bottom:0.6rem; padding:0.6rem; border-radius:var(--radius-sm); align-items:flex-start;">
                    <span class="recordatorio-color" style="background:@t.ColorHex; margin-top:0.2rem;"></span>
                    <div style="flex:1;">
                        <div style="display:flex; align-items:center; gap:0.5rem; margin-bottom:0.2rem;">
                            <strong>@t.Nombre</strong>
                            <span class="badge @fase.ClaseBadge">@fase.Titulo</span>
                        </div>
                        <span class="text-muted">@fase.Mensaje</span>
                    </div>
                </div>
            }
        }
    </div>
}

@code {
    private List<CreditCardDto> tarjetas = [];
    private List<PaymentReminderDto> proximosVencimientos = [];
    private List<PaymentReminderDto> todosLosRecordatorios = [];
    private bool cargando = true;
    private bool sinConexion;
    private bool errorServidor;
    private decimal monto;
    private bool recomendando;
    private RecomendacionResponse? recomendacion;

    protected override async Task OnInitializedAsync()
    {
        UserProfile.CambioPerfil += OnPerfilCambio;
        await CargarAsync();
    }

    private async Task CargarAsync()
    {
        cargando = true;
        sinConexion = false;
        errorServidor = false;

        var resultado = await CreditCardApi.ObtenerTodasAsync();
        if (resultado.Exitoso)
        {
            tarjetas = resultado.Datos!;

            if (tarjetas.Count > 0)
            {
                // Widget secundario: si falla, simplemente no se muestra — no bloquea el resto del Dashboard.
                var recordatorios = await RemindersApi.ObtenerTodosAsync();
                if (recordatorios.Exitoso)
                {
                    todosLosRecordatorios = recordatorios.Datos!;
                    // Solo lo que de verdad está "próximo": sin pagar y su fecha límite no ha pasado —
                    // lo ya vencido lo cubre la sección "Mejora tu score" con la fase "⚠️ Urgente" (ver
                    // SPEC-003 "Próximos vencimientos vs. Historial").
                    proximosVencimientos = todosLosRecordatorios.Where(r => !r.Pagado && r.DiasHastaLimite >= 0).OrderBy(r => r.DiasHastaLimite).Take(3).ToList();
                }
            }
        }
        else
        {
            sinConexion = resultado.SinConexion;
            errorServidor = resultado.ErrorServidor;
        }

        cargando = false;
    }

    private async Task RecomendarAsync()
    {
        recomendando = true;
        try
        {
            recomendacion = await RecommendationApi.RecomendarAsync(monto);
        }
        catch (Exception ex) when (ex is HttpRequestException or TaskCanceledException)
        {
            recomendacion = null;
            await Dialogs.ToastErrorAsync("No se pudo conectar. Revisa tu conexión a internet.");
        }
        finally
        {
            recomendando = false;
        }
    }

    /// <summary>
    /// El recordatorio de una tarjeta que de verdad importa mostrar: el pendiente más próximo a
    /// vencer (nunca el ciclo vigente más reciente sin más) — una tarjeta puede tener a la vez un
    /// recordatorio viejo sin pagar (todavía dentro de su plazo) y uno nuevo recién generado para el
    /// ciclo que apenas empezó; mostrar el nuevo escondería que hay algo pendiente por pagar. Si no
    /// hay ninguno pendiente, se usa el más reciente ya pagado (para el estado "Ciclo al día").
    /// </summary>
    private PaymentReminderDto? RecordatorioRelevante(Guid creditCardId)
    {
        var deLaTarjeta = todosLosRecordatorios.Where(r => r.CreditCardId == creditCardId);

        return deLaTarjeta.Where(r => !r.Pagado).OrderBy(r => r.FechaLimitePago).FirstOrDefault()
            ?? deLaTarjeta.OrderByDescending(r => r.CicloFin).FirstOrDefault();
    }

    /// <summary>
    /// Guía accionable por fase del ciclo (ver SPEC-003 "Guía de fase del ciclo") — no introduce datos
    /// nuevos, solo interpreta los campos que ya trae PaymentReminderDto para decirle al usuario qué
    /// hacer hoy con cada tarjeta, no solo cuándo vence.
    /// </summary>
    private static (string Titulo, string Mensaje, string ClaseBadge) FaseDeCiclo(PaymentReminderDto r, DateTime hoy)
    {
        if (r.Pagado)
        {
            return ("✅ Ciclo al día", "Ya pagaste este ciclo. Vas muy bien.", "badge-success");
        }

        if (hoy < r.FechaOptimaPago.Date)
        {
            return ("Puedes seguir usando tu tarjeta",
                $"Tu corte es el {r.CicloFin:dd/MM}. Si quieres bajar la utilización que se reporta, procura pagar antes del {r.FechaOptimaPago:dd/MM}.",
                "");
        }

        if (hoy < r.CicloFin.Date)
        {
            return ("🎯 Ventana óptima de pago",
                $"Faltan pocos días para tu corte ({r.CicloFin:dd/MM}). Pagar ahora reduce el saldo que se reporta este ciclo y ayuda a tu score.",
                "badge-alerta");
        }

        if (hoy < r.FechaLimitePago.Date)
        {
            return ("Corte hecho — paga a tiempo",
                $"Tu corte ya pasó. Tienes hasta el {r.FechaLimitePago:dd/MM} para pagar sin generar intereses ni atraso.",
                "");
        }

        return ("⚠️ Urgente",
            "Ya venció tu fecha límite. Un pago tardío es lo que más daña tu score — paga lo antes posible.",
            "badge-danger");
    }

    private static string UrgenciaClase(UrgenciaPagoDto urgencia) => urgencia switch
    {
        UrgenciaPagoDto.Vencido => "badge-danger",
        UrgenciaPagoDto.Inminente => "badge-danger",
        UrgenciaPagoDto.Proximo => "badge-alerta",
        _ => ""
    };

    private void OnPerfilCambio() => InvokeAsync(StateHasChanged);

    public void Dispose() => UserProfile.CambioPerfil -= OnPerfilCambio;
}
