@inject IJSRuntime JS
@implements IAsyncDisposable

<div class="login-shell">
    <div class="login-section">
        <div class="login-visual-copy">
            <span class="tag tag-oculto" aria-hidden="true">tarjetas de crédito</span>
            <h2>@HeadlineLinea1<br />@HeadlineLinea2</h2>
            <p>@Subtitulo</p>
        </div>

        <div class="login-visual-stage parallax-stage">
            <div class="login-card-float parallax-item login-card-float-1"></div>
            <div class="login-card-float parallax-item login-card-float-2"></div>
            <div class="login-card-float parallax-item login-card-float-3">
                <div class="login-card-chip"></div>
                <div class="login-card-lines">
                    <span></span>
                    <span></span>
                </div>
            </div>
        </div>

        <div class="login-form-card">
            @ChildContent
        </div>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public string HeadlineLinea1 { get; set; } = "";
    [Parameter, EditorRequired] public string HeadlineLinea2 { get; set; } = "";
    [Parameter, EditorRequired] public string Subtitulo { get; set; } = "";
    [Parameter] public RenderFragment? ChildContent { get; set; }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JS.InvokeVoidAsync("parallaxStage.init", ".login-visual-stage", ".login-card-float", 3);

            // Bloquea el scroll del <body> completo mientras el login/register está montado (ver
            // SPEC-005 "Login: sección única, sin scroll" — bug real de scroll en móvil, 2026-09-10).
            // Se quita en DisposeAsync para no afectar el resto de la app tras iniciar sesión.
            await JS.InvokeVoidAsync("document.body.classList.add", "auth-route");
        }
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("document.body.classList.remove", "auth-route");
        }
        catch (JSDisconnectedException)
        {
            // La conexión JS ya se cerró (ej. navegación que descarga la página) — nada que limpiar.
        }
    }
}
