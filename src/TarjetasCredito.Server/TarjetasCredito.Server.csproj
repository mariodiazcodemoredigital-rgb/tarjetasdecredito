<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>aea83184-9f23-4d42-a015-53c9495b269b</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.11" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.Server" Version="10.0.11" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.11" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.11">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Swashbuckle.AspNetCore.SwaggerUI" Version="10.2.3" />
  </ItemGroup>

  <ItemGroup>
    <!-- Referencia al Client: al publicar el Server (dotnet publish), el SDK de WebAssembly.Server
         compila el Client y copia su salida al wwwroot del Server — ver SPEC-001 "Despliegue con
         Docker". El flujo de desarrollo (dos procesos, dotnet run por separado) no cambia. -->
    <ProjectReference Include="..\TarjetasCredito.Client\TarjetasCredito.Client.csproj" />
    <ProjectReference Include="..\TarjetasCredito.Domain\TarjetasCredito.Domain.csproj" />
    <ProjectReference Include="..\TarjetasCredito.Infrastructure\TarjetasCredito.Infrastructure.csproj" />
    <ProjectReference Include="..\TarjetasCredito.Shared\TarjetasCredito.Shared.csproj" />
  </ItemGroup>

</Project>
